rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isUser(user) {
      return request.auth != null && request.auth.uid == user;
    }
    
    function isUserInReceipts() {
      return resource.data.receipts != null &&
         resource.data.receipts.hasAny([request.auth.token.email]);
    }
    
    function isOwner() {
    	return resource.data.sharedBy == request.auth.token.email;
    }
    
    match /users/{userId} {
      allow read, create, update, delete: if isUser(userId);
    }
    
    match /vaults/{vaultId} {
    	allow read: if isUserInReceipts() || isOwner();
      allow create: if request.auth != null && request.auth.token.email_verified;
      allow delete: if isOwner();
      allow update: if isUserInReceipts() || isOwner();
    } 
  }
}
